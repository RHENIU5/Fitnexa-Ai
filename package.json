{
  "name": "fitnexa-ai",
  "version": "1.0.0",
  "description": "Fitness and gym operations platform with member and admin portals, backed by Express, Prisma and MongoDB Atlas.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node server/index.js",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint",
    "check": "npm run lint && npm run build",
    "test:api": "node tests/api.smoke.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed-demo": "node scripts/seed-demo-data.js",
    "admin:setup": "node scripts/provision-admin.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.63.0",
    "morgan": "^1.12.1",
    "prisma": "6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
