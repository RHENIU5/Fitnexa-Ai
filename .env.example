# Copy to .env and replace the placeholder values before running the app.

# Express API port. The Vite dev server proxies /api to http://localhost:3001.
PORT=3001

# Random secret of at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# MongoDB Atlas direct replica-set URI. Replace both placeholders; URL-encode the password.
DATABASE_URL=mongodb://<db_username>:<URL-encoded-db_password>@ac-hp1apfv-shard-00-00.9odajuc.mongodb.net:27017,ac-hp1apfv-shard-00-01.9odajuc.mongodb.net:27017,ac-hp1apfv-shard-00-02.9odajuc.mongodb.net:27017/fitnexa_ai?tls=true&authSource=admin&replicaSet=atlas-xxi40w-shard-0&retryWrites=true&w=majority
